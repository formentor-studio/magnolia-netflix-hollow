<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module SYSTEM "module.dtd" >
<module>
  <name>netflix-hollow-producer</name>
  <displayName>${project.name}</displayName>
  <description>${project.description}</description>
  <class>org.formentor.magnolia.hollow.HollowProducerModule</class>
  <versionHandler>org.formentor.magnolia.hollow.setup.HollowProducerModuleVersionHandler</versionHandler>
  <version>${project.version}</version>

  <!-- For more information on module descriptor configuration options -->
  <!-- https://documentation.magnolia-cms.com/display/DOCS/XML-based+module+descriptor -->
  <components>
    <id>main</id>
    <component>
      <type>org.formentor.magnolia.hollow.application.ContentSnapshotPublisher</type>
      <implementation>org.formentor.magnolia.hollow.application.ContentSnapshotPublisher</implementation>
      <scope>singleton</scope>
    </component>
    <component>
      <type>org.formentor.magnolia.hollow.domain.HollowPublisher</type>
      <implementation>org.formentor.magnolia.hollow.infrastructure.HollowPublisherS3</implementation>
      <scope>singleton</scope>
    </component>
    <component>
      <type>org.formentor.magnolia.hollow.domain.HollowAnnouncer</type>
      <implementation>org.formentor.magnolia.hollow.infrastructure.HollowAnnouncerDynamoDB</implementation>
      <scope>singleton</scope>
    </component>
    <component>
      <type>org.formentor.magnolia.hollow.domain.HollowBlobRetriever</type>
      <implementation>org.formentor.magnolia.hollow.infrastructure.HollowBlobRetrieverS3</implementation>
      <scope>singleton</scope>
    </component>
    <component>
      <type>org.formentor.magnolia.hollow.domain.HollowAnnouncementWatcher</type>
      <implementation>org.formentor.magnolia.hollow.infrastructure.HollowAnnouncementWatcherDynamoDB</implementation>
      <scope>singleton</scope>
    </component>
  </components>
  <dependencies>
    <dependency>
      <name>core</name>
      <version>*</version>
    </dependency>
    <!--  Add other dependencies here, e.g the mte (magnolia templating essentials).
    <dependency>
      <name>mte</name>
      <version>0.7/*</version>
    </dependency>
    -->
  </dependencies>
</module>
